-- Tab Content
local tabContent = Instance.new("Frame", mainFrame)
tabContent.Position = UDim2.new(0, 100, 0, 30)
tabContent.Size = UDim2.new(1, -100, 1, -30)
tabContent.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
tabContent.Name = "Content"

local function createTab(name)
	local button = Instance.new("TextButton", tabButtons)
	button.Size = UDim2.new(1, 0, 0, 40)
	button.Text = name
	button.TextColor3 = Color3.new(1, 1, 1)
	button.Font = Enum.Font.Gotham
	button.TextSize = 14
	button.BackgroundColor3 = Color3.fromRGB(40, 40, 40)

	local content = Instance.new("Frame", tabContent)
	content.Size = UDim2.new(1, 0, 1, 0)
	content.Visible = false
	content.Name = name
	content.BackgroundTransparency = 1

	button.MouseButton1Click:Connect(function()
		for _, v in pairs(tabContent:GetChildren()) do
			if v:IsA("Frame") then v.Visible = false end
		end
		content.Visible = true
	end)

	return content
end

