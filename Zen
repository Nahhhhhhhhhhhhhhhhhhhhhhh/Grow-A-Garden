-- Dropdown for matches
local dropdownFrame = Instance.new("Frame", autoFarmsFrame)
dropdownFrame.Size = UDim2.new(0, 180, 0, 100)
dropdownFrame.Position = UDim2.new(0, 10, 0, 105)
dropdownFrame.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
dropdownFrame.BorderSizePixel = 0
dropdownFrame.Visible = false
dropdownFrame.ClipsDescendants = true

local uiList = Instance.new("UIListLayout", dropdownFrame)
uiList.Padding = UDim.new(0, 4)
uiList.SortOrder = Enum.SortOrder.LayoutOrder

local fruitName = ""

local function updateDropdown(text)
	dropdownFrame:ClearAllChildren()
	uiList.Parent = dropdownFrame
	local found = {}
	for _, item in pairs(workspace:GetDescendants()) do
		if item:IsA("Tool") and item:FindFirstChild("Handle") then
			local name = item.Name
			if name:lower():find(text:lower()) then
				found[name] = true
			end
		end
	end
	local count = 0
	for name in pairs(found) do
		count += 1
		local opt = Instance.new("TextButton", dropdownFrame)
		opt.Size = UDim2.new(1, 0, 0, 24)
		opt.Text = name
		opt.BackgroundColor3 = Color3.fromRGB(55, 55, 55)
		opt.TextColor3 = Color3.new(1, 1, 1)
		opt.Font = Enum.Font.Gotham
		opt.TextSize = 14
		opt.BorderSizePixel = 0
		opt.MouseButton1Click:Connect(function()
			fruitName = name
			fruitInput.Text = name
			dropdownFrame.Visible = false
		end)
	end
	dropdownFrame.Visible = count > 0
end

fruitInput:GetPropertyChangedSignal("Text"):Connect(function()
	updateDropdown(fruitInput.Text)
end)
fruitInput.FocusLost:Connect(function()
	task.delay(0.3, function()
		dropdownFrame.Visible = false
	end)
end)

